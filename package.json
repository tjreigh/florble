{
  "name": "florble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0",
    "build": "yarn content:check && yarn typecheck && yarn test && vite build",
    "content:generate": "node scripts/generate-daily-dictionary.mjs",
    "content:check": "node scripts/generate-daily-dictionary.mjs --check",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "word-list": "^4.1.0",
    "wrangler": "^4.108.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
